# ResQGrid Environment Configuration
# Zero-Bloat Emergency Response & Disaster Management Platform

# Server Port
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# When set, the application connects to your PostgreSQL instance.
# If PostgreSQL is not running or not configured, ResQGrid automatically runs on SQLite for zero-setup execution.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resqgrid
PGHOST=localhost
PGPORT=5432
PGDATABASE=resqgrid
PGUSER=postgres
PGPASSWORD=postgres

# Google Maps JavaScript API Configuration (Zero-Bloat GIS Map)
# Get a key at https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=

# Optional External ML Severity Inference Endpoint (FastAPI / Python)
# Leave blank to use the built-in transparent rule-based AI engine
ML_INFERENCE_URL=
