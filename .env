# ResQGrid Environment Configuration
# Zero-Bloat Emergency Response & Disaster Management Platform

# Server Port
PORT=3000
NODE_ENV=development

# Mapbox GL JS Configuration (Zero-Bloat GIS Map)
# Set your Mapbox Public Access Token here. It will be securely provided to authorized frontend sessions via /api/config/mapbox.
MAPBOX_ACCESS_TOKEN=pk.eyJ1IjoiZGVtb3VzZXIiLCJhIjoiY2x0ZXN0ZGVtb2NoZW5uYWkxMjM0NTY3OCJ9.demo_token_chennai

# Database Configuration (PostgreSQL)
# Uncomment the lines below when connecting to an active PostgreSQL database.
# When commented out or unreachable, ResQGrid automatically runs on SQLite with zero setup.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resqgrid
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=resqgrid
# PGUSER=postgres
# PGPASSWORD=postgres

# Optional External ML Severity Inference Endpoint (FastAPI / Python)
# Leave blank to use the built-in transparent rule-based AI engine
ML_INFERENCE_URL=
